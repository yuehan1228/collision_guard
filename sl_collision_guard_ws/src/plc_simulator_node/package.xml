<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>plc_simulator</name>
  <version>0.0.0</version>
  <description>PLC simulator and HMI for plc_interface integration testing</description>
  <maintainer email="lihaopeng@winh-ai.com">lhp</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rclcpp</build_depend>
  <build_depend>custom_msgs</build_depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>custom_msgs</exec_depend>
  <exec_depend>plc_interface</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
