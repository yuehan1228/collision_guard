#!/bin/sh
set -eu

URL="${CG_DEBUG_TOOL_URL:-${SERVICE_ADMIN_URL:-http://127.0.0.1:8080}}"

if command -v systemctl >/dev/null 2>&1; then
    if ! systemctl is-active --quiet collision-guard-visual-debugger.service; then
        notify-send "防碰撞系统可视化调试工具" "collision-guard-visual-debugger.service 未运行" >/dev/null 2>&1 || true
        exit 1
    fi
fi

if command -v xdg-open >/dev/null 2>&1; then
    exec xdg-open "$URL"
fi

if command -v sensible-browser >/dev/null 2>&1; then
    exec sensible-browser "$URL"
fi

printf '%s\n' "$URL"
